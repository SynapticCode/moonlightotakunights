# =====================================================================
# Moonlight Otaku Nights — environment variables
#
# On Hostinger this file lives at: /home/u833453975/.env  (OUTSIDE web root)
# NEVER commit the real .env to git.
# =====================================================================

# ----- App -----
APP_ENV=production
APP_BASE_URL=https://moonlightotakunights.com
DASHBOARD_URL=https://moonlightotakunights.com/dashboard
APP_TZ=America/New_York
APP_DEBUG=0

# ----- Database (Hostinger MySQL) -----
DB_HOST=localhost
DB_NAME=u833453975_mon_dashboard
DB_USER=u833453975_mon_admin
DB_PASS=                                # set after creating the DB user

# ----- Amazon SES (outbound email) -----
# Get from AWS Console -> SES -> Account dashboard -> SMTP settings -> Create credentials
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SMTP_PORT=465
SES_SMTP_USER=
SES_SMTP_PASS=
MAIL_FROM=info@moonlightotakunights.com
MAIL_FROM_NAME=Moonlight Otaku Nights
MAIL_REPLY_TO=info@moonlightotakunights.com

# ----- Google OAuth (dashboard login) -----
# Get from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://moonlightotakunights.com/dashboard/auth/google-callback.php
DASHBOARD_ALLOWED_EMAILS=anikuranj@gmail.com

# ----- Security -----
# Random 32-char string. Regenerating this invalidates all hashed IPs (fine).
IP_HASH_SALT=

# ----- Notifications (optional) -----
# ntfy.sh topic name. Free, no account. Get push alerts on cosplay signups.
NTFY_TOPIC=

# =====================================================================
# Server-side conversion tracking
# =====================================================================

# Already in code as defaults, but you can override per-environment:
GTM_CONTAINER_ID=GTM-WX8WHXSZ
GA4_MEASUREMENT_ID=G-8W7W5FKYV9
META_PIXEL_ID=1979608179640857

# ----- Meta Conversions API -----
# Generate in: Business Manager -> Events Manager -> Pixel -> Settings ->
#  Conversions API -> "Generate access token" (Business System User token).
# Test event code: Events Manager -> Test Events tab -> "Test Event Code" string
META_CAPI_TOKEN=
META_CAPI_TEST_EVENT=
META_CAPI_API_VERSION=v21.0

# ----- GA4 Measurement Protocol -----
# Generate in: GA4 Admin -> Data Streams -> Web -> Measurement Protocol API secrets
GA4_API_SECRET=

# ----- Google Ads (enhanced/offline conversions) -----
# Customer ID: top-right of Google Ads UI, format 123-456-7890 (no dashes here).
# Conversion ID + label: Tools -> Conversions -> click a conversion action -> "Tag setup"
GADS_CUSTOMER_ID=
GADS_CONVERSION_ID=
GADS_CONVERSION_LABEL=

TRACKING_ENABLED=1
